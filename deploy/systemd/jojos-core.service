[Unit]
Description=JoJo Core FastAPI service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/admini/jojos-core
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/admini/jojos-core/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=2
TimeoutStopSec=15
KillSignal=SIGINT

[Install]
WantedBy=default.target
